# ป้องกันการรันไฟล์สคริปต์ PHP ในโฟลเดอร์ uploads อย่างปลอดภัย (รองรับทั้ง Apache 2.4 และ Shared Hosting / InfinityFree)
<FilesMatch "\.(?i:php|phtml|phar|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

